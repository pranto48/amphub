{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AMPHUB",
  "version": "0.1.0",
  "identifier": "com.amphub.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AMPHUB",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 600,
        "maximized": false,
        "center": true,
        "additionalBrowserArgs": "--auto-select-desktop-capture-source=\"Entire Screen\" --use-fake-ui-for-media-stream --enable-features=WebRTCPipeWireCapturer"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
